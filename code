import React, { useEffect, useMemo, useState } from "react"; import { LineChart, Line, XAxis, YAxis, Tooltip, ResponsiveContainer, ReferenceArea } from "recharts"; import { saveAs } from "file-saver";

/**

Monitor de Precios de la Luz (España)


---

✅ Interactivo, responsive y con modo oscuro.

✅ Muestra precios por hora, medias, horas baratas/caras.

✅ Calculadora de coste según consumo horario o diario.

✅ Exportar a CSV.

✅ Fuentes de datos:

Modo DEMO (sin API): datos simulados realistas (€/MWh).


URL personalizada (JSON): pega una URL que devuelva [{ datetime, price }].


(Opcional) ESIOS/Red Eléctrica: deja preparado el hueco para token y dataset.


ℹ️ Nota sobre unidades

El gráfico y las tarjetas usan €/MWh (estándar del mercado mayorista).


En la calculadora puedes ver el coste en €/kWh (1 MWh = 1000 kWh). */



// --------- Utilidades de fecha/hora --------- const TZ = "Europe/Madrid"; const fmtHour = (date) => new Intl.DateTimeFormat("es-ES", { hour: "2-digit", minute: "2-digit", timeZone: TZ, hour12: false, }).format(date);

const yyyy_mm_dd = (date) => new Intl.DateTimeFormat("en-CA", { timeZone: TZ, year: "numeric", month: "2-digit", day: "2-digit" }) .format(date);

// --------- Datos DEMO para 24h --------- function generateDemoSeries(baseDate = new Date()) { const d = new Date(baseDate); d.setHours(0, 0, 0, 0); const series = []; // Perfil tipo: valle de madrugada, pico tarde-noche const base = 70; // €/MWh for (let h = 0; h < 24; h++) { const t = new Date(d.getTime() + h * 3600 * 1000); // Curva suave + ruido const wave = 20 * Math.sin(((h - 7) / 24) * Math.PI * 2) + 15 * Math.sin(((h + 2) / 24) * Math.PI * 4); const noise = (Math.random() - 0.5) * 6; const price = Math.max(10, Math.round((base + wave + noise) * 10) / 10); series.push({ datetime: t.toISOString(), price }); } return series; }

// --------- Descarga CSV --------- function toCSV(rows) { const header = ["datetime", "hour_local", "price_eur_mwh", "price_eur_kwh"]; const locale = new Intl.DateTimeFormat("en-CA", { timeZone: TZ, hour: "2-digit", minute: "2-digit", hour12: false }); const body = rows .map((r) => { const hourLocal = locale.format(new Date(r.datetime)); const kwh = r.price / 1000; // €/kWh return [r.datetime, hourLocal, r.price, kwh.toFixed(5)].join(","); }) .join("\n"); return [header.join(","), body].join("\n"); }

// --------- Cálculos clave --------- function computeStats(rows) { if (!rows?.length) return null; const prices = rows.map((r) => r.price); const avg = prices.reduce((a, b) => a + b, 0) / prices.length; const min = Math.min(...prices); const max = Math.max(...prices); const iMin = prices.indexOf(min); const iMax = prices.indexOf(max); return { avg, min, max, iMin, iMax }; }

function currentHourIndex(rows) { if (!rows?.length) return -1; const now = new Date(); const today = yyyy_mm_dd(now); return rows.findIndex((r, i) => { const dt = new Date(r.datetime); return yyyy_mm_dd(dt) === today && dt.getHours() === new Date().toLocaleString("en-US", { timeZone: TZ, hour: "2-digit", hour12: false }).padStart ? dt.getHours() : dt.getHours(); }); }

// --------- Fetched provider (URL personalizada) --------- async function fetchFromCustomURL(url) { const res = await fetch(url); if (!res.ok) throw new Error("No se pudo obtener datos de la URL personalizada"); const data = await res.json(); // Espera formato: [{ datetime, price }] if (!Array.isArray(data)) throw new Error("El JSON debe ser un array de objetos { datetime, price }"); return data.map((d) => ({ datetime: d.datetime, price: Number(d.price) })); }

// --------- Placeholder ESIOS --------- /**

Para usar ESIOS (Red Eléctrica), rellena token y dataset en el panel.

Este bloque ilustra la estructura, pero puede requerir ajustes según el dataset elegido.

Ejemplo de uso (comenta si no lo necesitas):

const rows = await fetchFromESIOS({ token, date: '2025-09-27', geoIds: ['8741'], dataset: 600 }); */ async function fetchFromESIOS({ token, date, geoIds = ["8741"], dataset = 600 }) { // ¡Revisa la documentación de ESIOS para el endpoint exacto del dataset que necesites! const url = https://api.esios.ree.es/indicators/${dataset}?start_date=${date}T00:00:00&end_date=${date}T23:59:59&geos[]=\${geoIds.join("&geos[]=")}; const res = await fetch(url, { headers: { Accept: "application/json; application/vnd.esios-api-v2+json", Authorization: Token token=\${token}, }, }); if (!res.ok) throw new Error("ESIOS: error de red o credenciales"); const json = await res.json(); // ⚠️ Adaptar a la forma concreta del indicador. // A modo de ejemplo, buscamos valores horarios en json.indicator.values const values = json?.indicator?.values || []; const rows = values.map((v) => ({ datetime: v.datetime, price: Number(v.value) })); return rows; }


// --------- Tooltip del gráfico --------- function PriceTooltip({ active, payload, label }) { if (!active || !payload?.length) return null; const p = payload[0].payload; const dt = new Date(p.datetime); const hour = new Intl.DateTimeFormat("es-ES", { timeZone: TZ, hour: "2-digit", minute: "2-digit", hour12: false }).format(dt); return ( <div className="rounded-2xl border bg-white/90 dark:bg-zinc-900/90 px-3 py-2 text-sm shadow-lg"> <div className="font-medium">{hour} h</div> <div className="opacity-80">{p.price.toFixed(1)} €/MWh</div> <div className="opacity-80">{(p.price / 1000).toFixed(5)} €/kWh</div> </div> ); }

// --------- Componente principal --------- export default function ElectricityPriceDashboard() { const [date, setDate] = useState(() => yyyy_mm_dd(new Date())); const [mode, setMode] = useState("demo"); // demo | custom | esios const [customURL, setCustomURL] = useState(""); const [esiosToken, setEsiosToken] = useState(""); const [esiosDataset, setEsiosDataset] = useState("600"); const [esiosGeo, setEsiosGeo] = useState("8741"); // Península por defecto (ejemplo) const [rows, setRows] = useState(() => generateDemoSeries()); const [loading, setLoading] = useState(false); const [error, setError] = useState(""); const [dailyKWh, setDailyKWh] = useState(5); // Consumo diario estimado del hogar const [hourlyProfile, setHourlyProfile] = useState(() => new Array(24).fill(0).map((_, i) => (i >= 19 && i <= 23 ? 0.35 : 0.65 / 19))); // Perfil por defecto

const stats = useMemo(() => computeStats(rows), [rows]); const nowIdx = useMemo(() => currentHourIndex(rows), [rows]);

useEffect(() => { (async () => { setError(""); setLoading(true); try { if (mode === "demo") { setRows(generateDemoSeries(new Date(date + "T00:00:00"))); } else if (mode === "custom" && customURL) { const data = await fetchFromCustomURL(customURL); setRows(data); } else if (mode === "esios" && esiosToken) { const data = await fetchFromESIOS({ token: esiosToken, date, geoIds: esiosGeo.split(",").map((s) => s.trim()), dataset: Number(esiosDataset) }); setRows(data); } else { setRows(generateDemoSeries(new Date(date + "T00:00:00"))); } } catch (e) { console.error(e); setError(e?.message || "Error al cargar datos"); } finally { setLoading(false); } })(); }, [mode, customURL, esiosToken, esiosDataset, esiosGeo, date]);

const cheapHours = useMemo(() => { if (!rows?.length) return []; const sorted = [...rows] .map((r, i) => ({ ...r, i })) .sort((a, b) => a.price - b.price) .slice(0, 5) .sort((a, b) => new Date(a.datetime) - new Date(b.datetime)); return sorted; }, [rows]);

const expensiveHours = useMemo(() => { if (!rows?.length) return []; const sorted = [...rows] .map((r, i) => ({ ...r, i })) .sort((a, b) => b.price - a.price) .slice(0, 5) .sort((a, b) => new Date(a.datetime) - new Date(b.datetime)); return sorted; }, [rows]);

const costByHour = useMemo(() => { // Convertimos €/MWh -> €/kWh const kwhPrice = rows.map((r) => r.price / 1000); // Reparte el consumo diario según el perfil horario (debe sumar 1) const totalWeight = hourlyProfile.reduce((a, b) => a + b, 0) || 1; const normalized = hourlyProfile.map((w) => w / totalWeight); const hourlyKWh = normalized.map((w) => w * dailyKWh); const costs = hourlyKWh.map((kwh, i) => kwh * (kwhPrice[i] ?? 0)); const total = costs.reduce((a, b) => a + b, 0); return { hourlyKWh, costs, total }; }, [rows, hourlyProfile, dailyKWh]);

const exportCSV = () => { const csv = toCSV(rows); const blob = new Blob([csv], { type: "text/csv;charset=utf-8" }); saveAs(blob, precios-luz-${date}.csv); };

return ( <div className="min-h-screen bg-gradient-to-b from-white to-zinc-50 dark:from-zinc-950 dark:to-zinc-900 text-zinc-900 dark:text-zinc-100"> <div className="mx-auto max-w-6xl p-4 md:p-8"> {/* Header */} <header className="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mb-6"> <div> <h1 className="text-2xl md:text-3xl font-semibold tracking-tight">Monitor de Precios de la Luz (España)</h1> <p className="text-sm opacity-70">Precios horarios, análisis y calculadora de coste • Zona horaria: {TZ}</p> </div> <div className="flex items-center gap-2"> <button onClick={() => { document.documentElement.classList.toggle("dark"); }} className="inline-flex items-center gap-2 rounded-2xl border px-3 py-2 text-sm shadow-sm hover:shadow transition" > <span>🌓</span> Modo oscuro </button> <button onClick={exportCSV} className="rounded-2xl border px-3 py-2 text-sm shadow-sm hover:shadow transition">Descargar CSV</button> </div> </header>

{/* Controles */}
    <section className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
      <div className="rounded-2xl border p-4">
        <label className="text-xs uppercase tracking-wide opacity-70">Fecha</label>
        <input type="date" value={date} onChange={(e) => setDate(e.target.value)} className="mt-1 w-full rounded-xl border px-3 py-2 bg-transparent" />
        <p className="text-xs mt-2 opacity-70">Cambia el día para ver el perfil de 24 horas.</p>
      </div>

      <div className="rounded-2xl border p-4">
        <label className="text-xs uppercase tracking-wide opacity-70">Fuente de datos</label>
        <select value={mode} onChange={(e) => setMode(e.target.value)} className="mt-1 w-full rounded-xl border px-3 py-2 bg-transparent">
          <option value="demo">DEMO (sin API)</option>
          <option value="custom">URL personalizada (JSON)</option>
          <option value="esios">ESIOS / Red Eléctrica (token)</option>
        </select>
        {mode === "custom" && (
          <div className="mt-3">
            <input
              placeholder="Pega una URL que devuelva [{ datetime, price }]"
              value={customURL}
              onChange={(e) => setCustomURL(e.target.value)}
              className="w-full rounded-xl border px-3 py-2 bg-transparent"
            />
            <p className="text-xs mt-2 opacity-70">Ejemplo de item: {{ datetime: "2025-09-27T00:00:00Z", price: 65.3 }}</p>
          </div>
        )}
        {mode === "esios" && (
          <div className="mt-3 grid grid-cols-1 gap-2">
            <input placeholder="Token ESIOS" value={esiosToken} onChange={(e) => setEsiosToken(e.target.value)} className="w-full rounded-xl border px-3 py-2 bg-transparent" />
            <input placeholder="Dataset (p. ej. 600)" value={esiosDataset} onChange={(e) => setEsiosDataset(e.target.value)} className="w-full rounded-xl border px-3 py-2 bg-transparent" />
            <input placeholder="Geo IDs separados por coma (p. ej. 8741)" value={esiosGeo} onChange={(e) => setEsiosGeo(e.target.value)} className="w-full rounded-xl border px-3 py-2 bg-transparent" />
            <p className="text-xs opacity-70">Consulta la documentación de ESIOS para escoger el indicador y la zona (geo).</p>
          </div>
        )}
      </div>

      <div className="rounded-2xl border p-4">
        <label className="text-xs uppercase tracking-wide opacity-70">Consumo diario estimado</label>
        <div className="mt-1 flex items-center gap-2">
          <input type="range" min={1} max={30} step={0.5} value={dailyKWh} onChange={(e) => setDailyKWh(parseFloat(e.target.value))} className="flex-1" />
          <div className="w-20 text-right tabular-nums">{dailyKWh.toFixed(1)} kWh</div>
        </div>
        <p className="text-xs mt-2 opacity-70">Ajusta para estimar el coste diario con el perfil horario.</p>
      </div>
    </section>

    {error && (
      <div className="mb-4 rounded-2xl border border-red-300 bg-red-50 dark:border-red-800 dark:bg-red-900/30 p-4 text-red-700 dark:text-red-200">
        ⚠️ {error}
      </div>
    )}

    {/* Métricas principales */}
    <section className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      <div className="rounded-2xl border p-4">
        <div className="text-sm opacity-70">Precio medio</div>
        <div className="mt-1 text-2xl font-semibold tabular-nums">{stats ? stats.avg.toFixed(1) : "–"} €/MWh</div>
        <div className="text-xs opacity-70">{stats ? (stats.avg / 1000).toFixed(5) : "–"} €/kWh</div>
      </div>
      <div className="rounded-2xl border p-4">
        <div className="text-sm opacity-70">Mínimo</div>
        <div className="mt-1 text-2xl font-semibold tabular-nums">{stats ? stats.min.toFixed(1) : "–"} €/MWh</div>
        {stats && rows[stats.iMin] && (
          <div className="text-xs opacity-70">a las {fmtHour(new Date(rows[stats.iMin].datetime))}</div>
        )}
      </div>
      <div className="rounded-2xl border p-4">
        <div className="text-sm opacity-70">Máximo</div>
        <div className="mt-1 text-2xl font-semibold tabular-nums">{stats ? stats.max.toFixed(1) : "–"} €/MWh</div>
        {stats && rows[stats.iMax] && (
          <div className="text-xs opacity-70">a las {fmtHour(new Date(rows[stats.iMax].datetime))}</div>
        )}
      </div>
    </section>

    {/* Gráfico */}
    <section className="rounded-2xl border p-4 mb-6">
      <div className="flex items-center justify-between mb-4">
        <h2 className="text-lg font-medium">Precios horarios ({date})</h2>
        {loading && <div className="text-sm opacity-70">Cargando…</div>}
      </div>
      <div className="h-64 md:h-80">
        <ResponsiveContainer width="100%" height="100%">
          <LineChart data={rows} margin={{ left: 8, right: 8, top: 8, bottom: 8 }}>
            <XAxis
              dataKey={(d) => new Date(d.datetime).toLocaleTimeString("es-ES", { timeZone: TZ, hour: "2-digit", minute: "2-digit", hour12: false })}
              tick={{ fontSize: 12 }}
            />
            <YAxis domain={["auto", "auto"]} tick={{ fontSize: 12 }} tickFormatter={(v) => `${v}€`} />
            <Tooltip content={<PriceTooltip />} />
            <Line type="monotone" dataKey="price" dot={false} strokeWidth={2} />
            {nowIdx >= 0 && rows[nowIdx] && (
              <ReferenceArea x1={rows[nowIdx]?.datetime} x2={rows[nowIdx]?.datetime} />
            )}
          </LineChart>
        </ResponsiveContainer>
      </div>
    </section>

    {/* Listas de horas baratas/caras */}
    <section className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
      <div className="rounded-2xl border p-4">
        <h3 className="font-medium mb-2">Horas más baratas</h3>
        <ul className="space-y-1 text-sm">
          {cheapHours.map((r, idx) => (
            <li key={`cheap-\${idx}`} className="flex items-center justify-between">
              <span className="opacity-80">{fmtHour(new Date(r.datetime))}</span>
              <span className="tabular-nums font-medium">{r.price.toFixed(1)} €/MWh</span>
            </li>
          ))}
        </ul>
      </div>
      <div className="rounded-2xl border p-4">
        <h3 className="font-medium mb-2">Horas más caras</h3>
        <ul className="space-y-1 text-sm">
          {expensiveHours.map((r, idx) => (
            <li key={`exp-\${idx}`} className="flex items-center justify-between">
              <span className="opacity-80">{fmtHour(new Date(r.datetime))}</span>
              <span className="tabular-nums font-medium">{r.price.toFixed(1)} €/MWh</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* Calculadora de coste */}
    <section className="rounded-2xl border p-4 mb-10">
      <h3 className="font-medium mb-4">Calculadora de coste diario</h3>
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div className="lg:col-span-2">
          <div className="text-sm opacity-70 mb-2">Perfil horario (reparte tu consumo en 24h). La suma debe ser 1.0</div>
          <div className="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-2">
            {hourlyProfile.map((w, i) => (
              <div key={`w-\${i}`} className="rounded-xl border p-2">
                <div className="text-xs opacity-70">{String(i).padStart(2, "0")}:00</div>
                <input
                  type="number"
                  step={0.01}
                  min={0}
                  value={w}
                  onChange={(e) => {
                    const next = [...hourlyProfile];
                    next[i] = parseFloat(e.target.value || "0");
                    setHourlyProfile(next);
                  }}
                  className="mt-1 w-full rounded-lg border px-2 py-1 bg-transparent text-sm"
                />
              </div>
            ))}
          </div>
          <div className="text-xs mt-2 opacity-70">
            Suma actual: {hourlyProfile.reduce((a, b) => a + b, 0).toFixed(2)} (recomendado 1.00). Puedes pegar un perfil de tu smart meter.
          </div>
        </div>
        <div className="lg:col-span-1">
          <div className="rounded-xl border p-4">
            <div className="text-sm opacity-70">Coste total estimado hoy</div>
            <div className="mt-1 text-3xl font-semibold tabular-nums">{costByHour.total.toFixed(2)} €</div>
            <div className="text-xs opacity-70">Precios actuales • {dailyKWh.toFixed(1)} kWh/día</div>
            <div className="mt-4 text-sm opacity-70">Top 3 horas para desplazar carga:</div>
            <ul className="mt-1 space-y-1 text-sm">
              {cheapHours.slice(0, 3).map((r, i) => (
                <li key={`shf-\${i}`} className="flex items-center justify-between">
                  <span>{fmtHour(new Date(r.datetime))}</span>
                  <span className="tabular-nums">{(r.price / 1000).toFixed(4)} €/kWh</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* Footer */}
    <footer className="pb-10 text-xs opacity-70">
      <p>
        ✨ Consejos: Usa la URL personalizada con tu backend o un proxy que normalice la respuesta a {{ datetime, price }}. Para ESIOS, consulta su
        documentación y elige el indicador que necesites (PVPC, mercado diario, etc.).
      </p>
      <p className="mt-2">Hecho con React + Tailwind + Recharts. Este componente es autónomo y puedes pegarlo directamente en tu proyecto.</p>
    </footer>
  </div>
</div>

); }

